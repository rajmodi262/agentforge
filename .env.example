# === StartupOS AI Environment Variables ===

# Database
DATABASE_URL=postgresql://startupos:startupos_dev@localhost:5432/startupos_db

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Mock Mode (CRITICAL: set to true during development to save API credits)
MOCK_MODE=true

# Brave Search API
BRAVE_SEARCH_API_KEY=BSAxxxxxxxxxxxxxxxxxx

# JWT Auth
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CORS
FRONTEND_URL=http://localhost:5173

# AWS (Phase 4 - not needed initially)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=startupos-reports
