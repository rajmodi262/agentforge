# === AgentForge AI Environment Variables ===

# Database (leave empty for SQLite fallback in development)
DATABASE_URL=postgresql://agentforge:agentforge_dev@localhost:5432/agentforge_db

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Mock Mode (CRITICAL: set to true during development to save API credits)
# In mock mode, agents return dynamic input-aware responses without calling Claude
MOCK_MODE=true

# Brave Search API (optional — mock results used if not set)
BRAVE_SEARCH_API_KEY=BSAxxxxxxxxxxxxxxxxxx

# JWT Auth (auto-generated in dev mode if not set)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CORS (frontend origin)
FRONTEND_URL=http://localhost:5173

# Server mode (development | production)
# In production: JWT_SECRET_KEY is required, stricter CORS, no auto-generated secrets
SERVER_MODE=development

# AWS S3 (future — for cloud report storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=agentforge-reports
